# Copy to apps/web/.env.local for local development. In production these live
# in Vercel's project settings. Never commit real values.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic Console API key that powers Chef (server only). Without it the app
# works, but Chef can only show the week, not change it.
ANTHROPIC_API_KEY=
# Optional: the Claude model Chef uses. Defaults to claude-opus-5-5.
CHEF_MODEL=

# Check-in reminder emails (Thursday 7 PM and Sunday 9 AM, each person's local time).
# Supabase: Project Settings > API Keys > Secret key (server only; skips row-level
# security, used only by the reminder job and signed email links).
SUPABASE_SECRET_KEY=
# Resend (resend.com, free plan): API key, and a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM="Chef <chef@commonthyme.app>"
# A long random string. Supabase Cron sends it to /api/cron/check-ins, and the
# one-tap email links are signed with a key derived from it.
CRON_SECRET=
# Optional: the site's address for email links. Defaults to Vercel's production URL.
APP_URL=
